# Copy to /etc/recorder/service.env (root:root 0600), replace ALL placeholders.
# systemd reads this file. This is not a shell script and has no real credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
POLICY_FILE=/var/lib/recorder/policy.json
POLICY_PRIVATE_KEY_FILE=/var/lib/recorder/private/policy.pem
STATS_DB=/var/lib/recorder/data/state.sqlite
ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_BEFORE_DEPLOYMENT
RELEASE_ARTIFACT_URL=https://github.com/REPLACE_OWNER/REPLACE_REPOSITORY/releases/download/v3.2.0/Recorder.zip
RELEASE_ARTIFACT_BUILD=6
RELEASE_DOWNLOAD_URL=https://recorder.example.invalid/download?channel=other
RELEASE_MANIFEST_FILE=/var/lib/recorder/artifacts/release-manifest.json
REFERRAL_PUBLIC_ORIGIN=https://recorder.example.invalid
REFERRAL_DEVICE_PEPPER=REPLACE_WITH_A_DISTINCT_RANDOM_SECRET_NEVER_ROTATE
REFERRAL_SERIES=3.2
REFERRAL_ARTIFACT_FILE=/var/lib/recorder/artifacts/Recorder.zip
REFERRAL_ARTIFACT_SHA256=REPLACE_WITH_REAL_SHA256
MAX_REQUESTS_PER_MINUTE=6000
MAX_TICKETS_PER_MINUTE=120
MAX_ACTIVE_REQUESTS=128
MAX_ACTIVE_DOWNLOADS=4
